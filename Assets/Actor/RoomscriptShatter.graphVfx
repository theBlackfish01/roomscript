    Node4:
      DependencyIndex: 4
      LevelID: 100
      NodeCount: 0
      NodeType: 1
      Ports:
        AttractRepelStrength:
          Variable: -100.0
        AttractRepelTarget:
          Variable: [0.0, 0.0, 0.0]
        Code:
          ClassType1: TEXT
          String: |
            void main() {
            	float i=float(system.getParticleIndex());
            	float angle=i*2.399963;
            	vec3 direction=vec3(cos(angle),sin(angle),sin(i*1.7));
            	system.setParticlePosition(vec3(mod(i,8.0)*3.0-10.5,floor(i/8.0)*2.0-10.0,0.0));
            	system.setParticleVelocity(direction*45.0);
            	system.setParticleMass(1.0);
            	system.setParticleSize(2.0+mod(i,3.0));
            	system.setParticleColor(vec4(0.247,0.89,1.0,1.0));
            	system.setParticleLife(1.2);
            }
        ColorA:
          Variable: [0.0, 0.0, 0.0, 1.0]
        ColorB:
          Variable: [1.0, 1.0, 1.0, 1.0]
        CustomCodeNodeAsset:
          ClassType1: REFUID
