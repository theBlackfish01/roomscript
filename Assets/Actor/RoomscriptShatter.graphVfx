            PortID: Texture
        Code:
          ClassType1: TEXT
          String: |
            input_texture_2d BaseTex;
            void main() {
            	vec2 uv=system.getSurfaceUVCoord0();
            	if(uv.y>1.0-abs(uv.x-0.5)*2.0)discard;
            	system.setPixelColor0(system.getParticleColor());
            }
