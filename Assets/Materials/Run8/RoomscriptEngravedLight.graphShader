    Node2:
      DependencyIndex: 2
      LevelID: 0
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_vec4 shapeInput;
            input_vec4 colorInput1;
            output_vec4 result;
            void main()
            {
            	vec3 n = normalize(system.getSurfaceNormalWorldSpace());
            	vec3 p = system.getSurfacePositionWorldSpace();
            	vec3 v = normalize(system.getCameraPosition() - p);
            	float facing = abs(dot(n, v));
            	float rim = pow(clamp(1.0 - facing, 0.0, 1.0), max(shapeInput.y, 0.5));
            	float bands = abs(fract(p.y * 0.55) - 0.5) * 2.0;
            	float engrave = smoothstep(0.82, 0.97, bands) * shapeInput.z * (1.0 - rim);
            	float glow = clamp(rim * 1.6 + engrave + shapeInput.x * 0.18, 0.0, 1.0) * max(shapeInput.w, 0.0);
            	vec3 color = colorInput1.rgb * glow;
            	result = vec4(color, clamp(glow * colorInput1.a, 0.0, 1.0));
            	if (result.a < 0.01) discard;
            }
        CustomCodeNodeAsset:
          ClassType1: REFUID
          String: ""
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        ID:
          Variable: 0
        Locked:
          Variable: false
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: Custom Code
        UseExternalFile:
          Variable: false
        shapeInput:
          Connection0:
            NodeLevelID: 2
            PortID: Output
          Variable: [0.0, 0.0, 0.0, 0.0]
        colorInput1:
          Connection0:
            NodeLevelID: 1
            PortID: Output
          Variable: [0.0, 0.0, 0.0, 0.0]
        ngs_Height:
          Variable: 400
        ngs_Version:
          String: 0.1.0
        result:
          IOType: 1
          Variable: [0.0, 0.0, 0.0, 0.0]
      PositionX: -59
      PositionY: 91
      TemplateID: node_util_custom
      TemplateVersionMinor: 2
