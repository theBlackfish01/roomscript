{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["tests/**/*.ts", "scripts/**/*.ts", "mocks/**/*.ts", "vitest.config.ts", "../Assets/Scripts/Engine/**/*.ts", "../Assets/Scripts/Content/**/*.ts"],
  "exclude": ["node_modules", "../Cache", "../Support"]
}
